{
  "name": "ts-config-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "src",
    "test/*"
  ],
  "scripts": {
    "clean": "git clean -dfx",
    "start": "npm install && npm test",
    "test": "npm run test --workspaces --if-present",
    "gen:default": "node ./scripts/generate-default-config.mts ./src/tsconfig.default.jsonc"
  },
  "devDependencies": {
    "typescript": ">=6.0.0"
  }
}
